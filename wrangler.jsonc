{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludotheque-jeux",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-15",
  "keep_vars": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ludotheque-jeux-db",
      // IMPORTANT : remplacez cet UUID par l'identifiant réel de votre base D1.
      "database_id": "5b8420e4-18b4-4d1e-a74d-5249d0650fb9",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ABALONE_ROOMS",
        "class_name": "AbaloneRoom"
      }
    ]
  },
  "exports": {
    "AbaloneRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
