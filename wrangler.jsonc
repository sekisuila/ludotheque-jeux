{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ludotheque-jeux",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ludotheque-jeux-db",
      // IMPORTANT : remplacez cet UUID par l'identifiant réel de votre base D1.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ABALONE_ROOMS",
        "class_name": "AbaloneRoom"
      }
    ]
  },
  "exports": {
    "AbaloneRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
